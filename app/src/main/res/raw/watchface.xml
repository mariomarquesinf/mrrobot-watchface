<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">

    <!-- ======================================================= -->
    <!-- USER CONFIGURATIONS: PALETAS DE COR (DEFAULT: FSOCIETY) -->
    <!-- ======================================================= -->
    <UserConfigurations>
        <ColorConfiguration id="themeColor" displayName="theme_color" defaultValue="1">
            <!-- 0: Lavanda Terminal Neon -->
            <ColorOption id="0" displayName="color_lavender" colors="#E9D5FF #C084FC #4C1D95" />
            <!-- 1: fsociety Vermelho (Padrão Mr. Robot) -->
            <ColorOption id="1" displayName="color_fsociety_red" colors="#FFE4E6 #F43F5E #881337" />
            <!-- 2: Kali Matrix Verde Terminal CRT -->
            <ColorOption id="2" displayName="color_terminal_green" colors="#DCFCE7 #22C55E #14532D" />
            <!-- 3: Cyber Ciano Neon -->
            <ColorOption id="3" displayName="color_cyber_cyan" colors="#E0F2FE #06B6D4 #164E63" />
            <!-- 4: Fósforo Âmbar Terminal Retro -->
            <ColorOption id="4" displayName="color_amber" colors="#FEF3C7 #F59E0B #78350F" />
            <!-- 5: Stealth Branco Monocromático -->
            <ColorOption id="5" displayName="color_monochrome" colors="#FFFFFF #CBD5E1 #334155" />
        </ColorConfiguration>
    </UserConfigurations>

    <!-- ======================================================= -->
    <!-- SCENE: HUD MR. ROBOT, RELÓGIO EM DESTAQUE MÁXIMO         -->
    <!-- ======================================================= -->
    <Scene backgroundColor="#000000">

        <!-- =================================================== -->
        <!-- MODO INTERATIVO: HUD completo. Ocultado inteiramente -->
        <!-- em modo ambiente (AOD) para poupar bateria e evitar  -->
        <!-- burn-in no ecrã AMOLED (ver Group "ambient_ui" abaixo). -->
        <!-- =================================================== -->
        <Group name="active_ui" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />

        <!-- =================================================== -->
        <!-- FUNDO: MARCA DE ÁGUA fsociety (desvanecida, cor do tema) -->
        <!-- =================================================== -->
        <PartImage x="65" y="65" width="320" height="320" alpha="40" tintColor="[CONFIGURATION.themeColor.1]">
            <Image resource="@drawable/fsociety_watermark" />
        </PartImage>

        <!-- =================================================== -->
        <!-- CAMADA GRÁFICA: RETÍCULA HUD (SEM ARO REDONDO)      -->
        <!-- =================================================== -->
        <PartDraw x="0" y="0" width="450" height="450">
            <!-- Retícula HUD estilo vigilância/mira (4 cantos), reforça estética hacker -->
            <!-- Canto NW -->
            <Line startX="80" startY="80" endX="100" endY="80">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>
            <Line startX="80" startY="80" endX="80" endY="100">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>
            <!-- Canto NE -->
            <Line startX="370" startY="80" endX="350" endY="80">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>
            <Line startX="370" startY="80" endX="370" endY="100">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>
            <!-- Canto SE -->
            <Line startX="370" startY="370" endX="350" endY="370">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>
            <Line startX="370" startY="370" endX="370" endY="350">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>
            <!-- Canto SW -->
            <Line startX="80" startY="370" endX="100" endY="370">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>
            <Line startX="80" startY="370" endX="80" endY="350">
                <Stroke thickness="2" color="[CONFIGURATION.themeColor.1]" cap="ROUND" />
            </Line>

            <!-- Linha Divisória Superior (Enquadra as Complicações) -->
            <Line startX="25" startY="218" endX="425" endY="218">
                <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.2]" />
            </Line>

            <!-- Linha Divisória Inferior (Enquadra as Complicações) -->
            <Line startX="25" startY="280" endX="425" endY="280">
                <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.2]" />
            </Line>
        </PartDraw>

        <!-- =================================================== -->
        <!-- CABEÇALHO DO TERMINAL (COMPACTO PARA DAR ESPAÇO ÀS HORAS) -->
        <!-- =================================================== -->
        <PartText x="0" y="44" width="450" height="20">
            <Text align="CENTER">
                <Font family="roboto_mono_bold" size="11" color="[CONFIGURATION.themeColor.1]">root@fsociety:~#</Font>
            </Text>
        </PartText>

        <!-- HELLO, FRIEND. (COMPACTO) -->
        <PartText x="0" y="64" width="450" height="22">
            <Text align="CENTER">
                <Font family="roboto_mono_bold" size="14" color="[CONFIGURATION.themeColor.0]">HELLO, FRIEND.</Font>
            </Text>
        </PartText>

        <!-- =================================================== -->
        <!-- RELÓGIO DIGITAL: ELEMENTO HERÓICO, MÁXIMO DESTAQUE  -->
        <!-- =================================================== -->
        <DigitalClock x="0" y="88" width="450" height="100">
            <TimeText
                x="0"
                y="0"
                width="450"
                height="100"
                format="hh:mm:ss"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER">
                <Font family="mr_robot" size="60" color="[CONFIGURATION.themeColor.1]" />
            </TimeText>
        </DigitalClock>

        <!-- =================================================== -->
        <!-- DATA DO SISTEMA -->
        <!-- =================================================== -->
        <PartText x="0" y="190" width="450" height="22">
            <Text align="CENTER">
                <Font family="roboto_mono_bold" size="12" color="[CONFIGURATION.themeColor.0]">
                    <Template>
                        <![CDATA[> SYS_DATE: %s.%s.%s // %s]]>
                        <Parameter expression="[YEAR]" />
                        <Parameter expression="[MONTH_Z]" />
                        <Parameter expression="[DAY_Z]" />
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        </Group>
        <!-- fim de "active_ui": complicações ficam sempre visíveis, -->
        <!-- são pequenas e de baixo custo em pixels acesos.         -->

        <!-- =================================================== -->
        <!-- TELEMETRIA: 4 COMPLICAÇÕES REAIS, GRELHA 2x2 RETA   -->
        <!-- Ícone da própria fonte de dados escolhida = label     -->
        <!-- sempre correto, nunca preso a um texto fixo nosso.   -->
        <!-- =================================================== -->

        <!-- COMPLICAÇÃO 0 (LINHA 1 ESQ) -->
        <ComplicationSlot
            slotId="0"
            supportedTypes="SHORT_TEXT EMPTY"
            x="10" y="224" width="210" height="24"
            isCustomizable="true"
            tintColor="[CONFIGURATION.themeColor.1]"
            displayName="slot_weather_label">
            <BoundingBox x="0" y="0" width="210" height="24" />
            <DefaultProviderPolicy defaultSystemProvider="DATE" defaultSystemProviderType="SHORT_TEXT" />

            <Complication type="SHORT_TEXT">
                <PartImage x="130" y="4" width="16" height="16" tintColor="[CONFIGURATION.themeColor.1]">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="150" y="0" width="58" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="START">
                        <Font family="roboto_mono_bold" size="16" color="[CONFIGURATION.themeColor.1]">
                            <Template>
                                <![CDATA[[%s]]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- COMPLICAÇÃO 1 (LINHA 1 DIR) -->
        <ComplicationSlot
            slotId="1"
            supportedTypes="SHORT_TEXT EMPTY"
            x="230" y="224" width="210" height="24"
            isCustomizable="true"
            tintColor="[CONFIGURATION.themeColor.1]"
            displayName="slot_heart_label">
            <BoundingBox x="0" y="0" width="210" height="24" />
            <DefaultProviderPolicy defaultSystemProvider="HEART_RATE" defaultSystemProviderType="SHORT_TEXT" />

            <Complication type="SHORT_TEXT">
                <PartImage x="22" y="4" width="16" height="16" tintColor="[CONFIGURATION.themeColor.1]">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="42" y="0" width="58" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="START">
                        <Font family="roboto_mono_bold" size="16" color="[CONFIGURATION.themeColor.1]">
                            <Template>
                                <![CDATA[[%s]]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- COMPLICAÇÃO 2 (LINHA 2 ESQ) -->
        <ComplicationSlot
            slotId="2"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY"
            x="10" y="250" width="210" height="24"
            isCustomizable="true"
            tintColor="[CONFIGURATION.themeColor.0]"
            displayName="slot_readiness_label">
            <BoundingBox x="0" y="0" width="210" height="24" />
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="RANGED_VALUE" />

            <Complication type="RANGED_VALUE">
                <PartImage x="130" y="4" width="16" height="16" tintColor="[CONFIGURATION.themeColor.0]">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="150" y="0" width="58" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="START">
                        <Font family="roboto_mono_bold" size="16" color="[CONFIGURATION.themeColor.0]">
                            <Template>
                                <![CDATA[[%s]]]>
                                <Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartImage x="130" y="4" width="16" height="16" tintColor="[CONFIGURATION.themeColor.0]">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="150" y="0" width="58" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="START">
                        <Font family="roboto_mono_bold" size="16" color="[CONFIGURATION.themeColor.0]">
                            <Template>
                                <![CDATA[[%s]]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- COMPLICAÇÃO 3 (LINHA 2 DIR) -->
        <ComplicationSlot
            slotId="3"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY"
            x="230" y="250" width="210" height="24"
            isCustomizable="true"
            tintColor="[CONFIGURATION.themeColor.0]"
            displayName="slot_steps_label">
            <BoundingBox x="0" y="0" width="210" height="24" />
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="RANGED_VALUE" />

            <Complication type="RANGED_VALUE">
                <PartImage x="22" y="4" width="16" height="16" tintColor="[CONFIGURATION.themeColor.0]">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="42" y="0" width="58" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="START">
                        <Font family="roboto_mono_bold" size="16" color="[CONFIGURATION.themeColor.0]">
                            <Template>
                                <![CDATA[[%s]]]>
                                <Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartImage x="22" y="4" width="16" height="16" tintColor="[CONFIGURATION.themeColor.0]">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="42" y="0" width="58" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="START">
                        <Font family="roboto_mono_bold" size="16" color="[CONFIGURATION.themeColor.0]">
                            <Template>
                                <![CDATA[[%s]]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <Group name="active_ui_footer" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />

        <!-- =================================================== -->
        <!-- STATUS HACKER (ESTÉTICA MR. ROBOT / ROOT ACCESS)    -->
        <!-- =================================================== -->
        <PartText x="0" y="286" width="450" height="16">
            <Text align="CENTER">
                <Font family="roboto_mono_bold" size="10" color="[CONFIGURATION.themeColor.0]">STATUS: ROOT PRIVILEGES GRANTED</Font>
            </Text>
        </PartText>

        <!-- =================================================== -->
        <!-- ASSINATURA: SITE PESSOAL -->
        <!-- =================================================== -->
        <PartText x="0" y="304" width="450" height="16">
            <Text align="CENTER">
                <Font family="roboto_mono_bold" size="10" color="[CONFIGURATION.themeColor.1]">mariomarquesinf.com // encrypted</Font>
            </Text>
        </PartText>

        <!-- =================================================== -->
        <!-- RODAPÉ TERMINAL -->
        <!-- =================================================== -->
        <PartText x="0" y="324" width="222" height="22">
            <Text align="END">
                <Font family="roboto_mono_bold" size="12" color="[CONFIGURATION.themeColor.1]">root@fsociety:~#</Font>
            </Text>
        </PartText>
        <!-- Cursor "_" a piscar ao ritmo dos segundos (blink de terminal real) -->
        <PartText x="228" y="324" width="222" height="22">
            <Transform target="alpha" value="[SECOND] % 2 == 0 ? 255 : 0" />
            <Text align="START">
                <Font family="roboto_mono_bold" size="12" color="[CONFIGURATION.themeColor.1]">_</Font>
            </Text>
        </PartText>

        </Group>

        <!-- =================================================== -->
        <!-- MODO AMBIENTE (AOD): apenas horas (sem segundos) e   -->
        <!-- data, em tom apagado. Invisível em modo interativo   -->
        <!-- (alpha="0"), só aparece via Variant mode="AMBIENT".  -->
        <!-- Cumpre a diretriz Wear OS de <15% de pixels acesos.  -->
        <!-- =================================================== -->
        <Group name="ambient_ui" x="0" y="0" width="450" height="450" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />

            <!-- Referência Mr. Robot discreta, mantém identidade também em ambiente -->
            <PartText x="0" y="26" width="450" height="16">
                <Text align="CENTER">
                    <Font family="roboto_mono_bold" size="10" color="#555555">root@fsociety:~#</Font>
                </Text>
            </PartText>

            <DigitalClock x="0" y="50" width="450" height="140">
                <TimeText
                    x="0" y="0" width="450" height="140"
                    format="hh:mm"
                    hourFormat="SYNC_TO_DEVICE"
                    align="CENTER">
                    <Font family="mr_robot" size="66" color="#666666" />
                </TimeText>
            </DigitalClock>

            <PartText x="0" y="196" width="450" height="16">
                <Text align="CENTER">
                    <Font family="roboto_mono_regular" size="12" color="#4A4A4A">
                        <Template>
                            <![CDATA[%s.%s.%s]]>
                            <Parameter expression="[YEAR]" />
                            <Parameter expression="[MONTH_Z]" />
                            <Parameter expression="[DAY_Z]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

    </Scene>
</WatchFace>
